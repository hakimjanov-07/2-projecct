# Nusxa oling: .env nomi bilan saqlang va qiymatlarni to'ldiring (.env gitga qo'shilmaydi)
SECRET_KEY=o'zingizning-maxfiy-kalitingiz
DEBUG=True

# --- Emailga tasdiqlash kodi yuborish ---
# Xat "BookShop" nomidan boradi (nomni o'zgartirish: EMAIL_FROM_NAME=...)
# EMAIL_HOST_USER yozilmasa, xat email o'rniga server konsoliga chiqadi (sinov uchun).

# 1-variant: Gmail (eng oson; xat "BookShop <sizning@gmail.com>" ko'rinishida keladi)
#   a) Google hisobingizda 2 bosqichli tasdiqlashni yoqing
#   b) https://myaccount.google.com/apppasswords sahifasidan "App password" yarating
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# 2-variant: o'z domeningiz manzilidan (masalan noreply@bookshop.uz) - Resend, Brevo, SendGrid va h.k.
#   Xizmatda domeningizni tasdiqlang, so'ng quyidagilarni yozing (Resend uchun namuna):
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=xizmatdan_olingan_API_kalit
# EMAIL_FROM_ADDRESS=noreply@sizning-domeningiz.uz
# EMAIL_FROM_NAME=BookShop

# 3-variant: Resend, domensiz (faqat SINOV uchun): xat "BookShop <onboarding@resend.dev>" nomidan boradi,
#   lekin Resend faqat O'ZINGIZNING Resend hisobingizdagi email manzilga yetkazadi (boshqalarga yubormaydi).
# EMAIL_HOST=smtp.resend.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=resend
# EMAIL_HOST_PASSWORD=Resend_dan_olingan_API_kalit
# EMAIL_FROM_ADDRESS=onboarding@resend.dev
# EMAIL_FROM_NAME=BookShop

# --- Serverga chiqarish (production). Quyidagilar faqat DEBUG=False bo'lganda ishlaydi ---
# Production'da DEBUG=False qiling (yuqoridagi DEBUG=True faqat lokal uchun) va SECRET_KEY ni yangi, uzun tasodifiy qiymatga almashtiring.
# Ruxsat etilgan domenlar (vergul bilan). Berilmasa: bookshoptest.pythonanywhere.com,127.0.0.1,localhost
# ALLOWED_HOSTS=sizning-domeningiz.uz,www.sizning-domeningiz.uz
# Frontend manzillari (CORS, vergul bilan, sxema bilan: https://...)
# CORS_ALLOWED_ORIGINS=https://sizning-frontend-domeningiz.uz
# Admin va CSRF uchun ishonchli HTTPS manzillar (vergul bilan, sxema bilan). Bo'sh qolsa ro'yxat bo'sh bo'ladi.
# CSRF_TRUSTED_ORIGINS=https://sizning-domeningiz.uz
# HTTP -> HTTPS yo'naltirish (standart: True). Faqat HTTPS hali sozlanmagan bo'lsa vaqtincha False qiling.
# SECURE_SSL_REDIRECT=True
# HSTS muddati (soniya). Standart 3600 (1 soat) - ehtiyotkor boshlash. Hammasi barqaror ishlagach 86400 (1 kun), keyin 31536000 (1 yil) qiling.
# SECURE_HSTS_SECONDS=3600

# --- Kirish/ro'yxatdan o'tish cheklovi (IP bo'yicha; brute-force himoyasi). Standart: login 10/minute, register 20/hour ---
# THROTTLE_LOGIN=10/minute
# THROTTLE_REGISTER=20/hour
# Proksi qatlamlari soni: IP X-Forwarded-For dan olinadi. Bo'sh qolsa DRF sarlavhaning hammasiga ishonadi va hujumchi
# uni soxtalashtirib cheklovdan o'ta oladi. Productionda (proksi/balanser orqasida) albatta yozing, masalan 1.
# Lokal (to'g'ridan-to'g'ri ulanish)da bo'sh qoldiring yoki 0 yozing.
# NUM_PROXIES=1

# Ochiq savat hisob-kitobi (/api/cart/quote/) IP bo'yicha cheklovi (promo kodni terib topishdan himoya). Standart: 60/minute
# THROTTLE_QUOTE=60/minute

# Bitta hisobga soatiga yuboriladigan parol tiklash kodlari soni (oshsa xat yuborilmaydi, javob bir xil). Standart: 5
# PASSWORD_RESET_MAX_PER_HOUR=5
